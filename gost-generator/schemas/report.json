{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gost/report.schema.json",
  "title": "Результат проверки документа (data-часть конверта gost check)",
  "type": "object",
  "required": ["file", "preset", "strict", "summary", "issues"],
  "properties": {
    "file": {"type": "string"},
    "preset": {"type": "string"},
    "strict": {"type": "boolean"},
    "read_error": {"type": ["string", "null"]},
    "summary": {
      "type": "object",
      "required": ["error", "warning", "info"],
      "properties": {
        "error": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"type": "string", "enum": ["error", "warning", "info"]},
          "message": {"type": "string"},
          "location": {
            "type": "object",
            "properties": {
              "paragraph": {"type": ["integer", "null"]},
              "page": {"type": ["integer", "null"]},
              "snippet": {"type": "string"}
            }
          },
          "hint": {"type": "string"}
        }
      }
    }
  }
}
